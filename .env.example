# FitOS configuration

# ---------------------------------------------------------------------------
# Local development (default)
# ---------------------------------------------------------------------------
# PGlite stores its PostgreSQL files here. Ignored when DATABASE_URL is set.
FITOS_DATA_DIR=.data/fitos

# ---------------------------------------------------------------------------
# Managed PostgreSQL (required on Vercel)
# ---------------------------------------------------------------------------
# Set to a managed PostgreSQL connection string (Neon, Vercel Marketplace, etc.)
# and FitOS will stop using PGlite. On serverless platforms use the POOLED
# connection string, for example:
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# The app auto-creates the schema and (optionally) seeds demo data once on the
# first request. To run DDL yourself instead, apply db/migrations/0001_init.sql
# and set FITOS_AUTO_MIGRATE=false.
# DATABASE_URL=
# Vercel Marketplace integrations that expose POSTGRES_URL are also supported.

# Force TLS on/off. When unset, TLS is enabled for every non-local database host.
# DATABASE_SSL=true

# Set to true to verify the database server certificate. Defaults to false so
# hosted providers with rotating CA bundles work out of the box.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Connections per serverless instance. Keep this small with a pooled endpoint.
# DATABASE_POOL_MAX=3

# Set to false to skip automatic schema creation and demo seeding. Default: true.
# FITOS_AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# App secrets and URLs
# ---------------------------------------------------------------------------
# 32+ random characters. Used to sign member QR tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QR_TOKEN_SECRET=

# Absolute app URL used in invite links when headers are unavailable.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seeds the demo gym only when the profiles table is empty. Set to false for a
# real personal deployment; the demo credentials are public.
FITOS_SEED_DEMO=true

# Set to false to hide the one-click demo account buttons.
FITOS_DEMO_MODE=true

# In production, password reset links are not shown in the UI unless this is true.
# Connect an email provider before enabling a real reset flow in production.
FITOS_SHOW_RESET_LINK=false

# Production safety valve: never enable this in a real deployment.
FITOS_ALLOW_DEV_SECRETS=false
